[Unit]
Description=Suzerain control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust to your install location (mise run package installs to ~/.local/bin)
ExecStart=%h/.local/bin/suzerain run
Restart=on-failure
RestartSec=5
# Required for SOPS decryption:
#Environment=SOPS_AGE_KEY_FILE=%h/.config/sops/age/keys.txt
# Optional:
#Environment=SUZERAIN_DATABASE_URL=postgres://suzerain@localhost/suzerain
#Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
