[Unit]
Description=Suzerain (fleet manager: control plane + agent hosting, one binary)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust to your install location (mise run package installs to ~/.local/bin)
# Add --mode control or --mode agent for a dedicated (non-standalone) host.
ExecStart=%h/.local/bin/suzerain run
Restart=on-failure
RestartSec=5
# Optional: age identity override (default: the fleet home's age-keys.txt):
#Environment=SOPS_AGE_KEY_FILE=%h/.local/share/suzerain/age-keys.txt
# Optional:
#Environment=SUZERAIN_DATABASE_URL=postgres://suzerain@localhost/suzerain
#Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# `suzerain run` defaults to standalone mode (control plane + a co-located
# agent-worker child) — qemu + node must be on PATH for that child's
# Gondolin VMs. Drop the mise-shims entry if this host runs
# `--mode control` only (no local agent hosting).
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
